# Use a unique project name for each separate clone/environment.
# Do not rename an existing deployment to add another organization.
# Generate .env with bash scripts/configure.sh; set ALLOWED_REPOS explicitly.
COMPOSE_PROJECT_NAME=chatgpt-github-agent
HOST_UID=501
HOST_GID=20
GITHUB_APP_ID=123456
ALLOWED_REPOS=
CONTROL_PLANE_TUNNEL_ID=tunnel_00000000000000000000000000000000
DEV_CPUS=4
DEV_MEMORY=6g
GO_IMAGE=golang:1.26-bookworm
NODE_IMAGE=node:24-bookworm-slim
TUNNEL_IMAGE=ghcr.io/openai/tunnel-client:v0.0.15

# Source import limits (MiB); see docs/large-repositories.md. Not PR publication limits.
SOURCE_MAX_ARCHIVE_MIB=512
SOURCE_MAX_TOTAL_MIB=2048
SOURCE_MAX_FILE_MIB=128
